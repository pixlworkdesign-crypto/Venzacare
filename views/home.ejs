<%- include('partials/header') %>

<% var d = home.details || {}; var homePhone = d.phone || SITE.phone; var homeTel = homePhone.replace(/\s/g,''); var from = fromPrice(home); %>
<section class="page-hero home-hero<%= home.photo ? ' has-photo' : '' %>"<% if (home.photo) { %> style="--hero-photo:url('<%= photoSrc(home.photo) %>');"<% } %>>
  <div class="container">
    <div class="crumbs"><a href="/">Home</a> › <a href="/care-homes">Find a home</a> › <%= home.name %></div>
    <a class="home-card__rating <%= cqcClass(home) %> home-hero__rating" href="#cqc">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Z"/></svg>
      CQC: <%= cqcLabel(home) %>
    </a>
    <h1><%= home.name %></h1>
    <p><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg> <%= home.town %> · <%= home.postcode %><% if (from) { %> · from <strong><%= gbp(from) %></strong> per week<% } %></p>
    <div class="hero__cta" style="margin-top:1.2rem;">
      <a href="#visit" class="btn btn--gold">Book a visit</a>
      <a href="tel:<%= homeTel %>" class="btn btn--outline-light">Call <%= homePhone %></a>
    </div>
  </div>
</section>
<% if (home.photo) { %><div class="home-hero__photo" role="img" aria-label="Outside <%= home.name %>" style="background-image:url('<%= photoSrc(home.photo) %>');"></div><% } %>

<section class="section">
  <div class="container">
    <div class="job-detail">
      <div class="prose">
        <p class="lead"><%= home.blurb %></p>
        <h2>About this home</h2>
        <p><%= home.name %> is a <%= home.beds %>-bed care home in <%= home.town %>, offering <%= home.careTypes.join(', ').toLowerCase() %>.</p>
        <div class="care-panel">
          <h3>Types of care</h3>
          <ul class="tick-list">
            <% home.careTypes.forEach(function(c){ %>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><span><%= c %></span></li>
            <% }) %>
          </ul>
          <% if (home.dementiaNote) { %>
          <p class="muted" style="font-size:0.9rem;margin:0.25rem 0 0;"><%= home.dementiaNote %></p>
          <% } %>

          <% if (home.specialisms && home.specialisms.length) { %>
          <h3>Specialist care we support</h3>
          <ul class="tick-list">
            <% home.specialisms.forEach(function(s){ %>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><span><%= s %></span></li>
            <% }) %>
          </ul>
          <% } %>

          <h3>Facilities &amp; daily life</h3>
          <div class="facility-grid">
            <% var facilities=[
              {l:'Comfortable lounges &amp; gardens', i:'M3 10.5 12 4l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z'},
              {l:'Freshly prepared meals, special diets catered for', i:'M3 12h18a9 9 0 0 1-18 0zM8 4v3M12 3v4M16 4v3'},
              {l:'Daily activities &amp; outings', i:'M9 18V6l12-2v12M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z'},
              {l:'En-suite rooms you can make your own', i:'M3 12h18v6M3 18v-8a1 1 0 0 1 1-1h7v5'},
              {l:'Open visiting &mdash; family welcome any time', i:'M16 21v-2a4 4 0 0 0-8 0v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z'}
            ]; facilities.forEach(function(f){ %>
            <div class="fac"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="<%= f.i %>"/></svg><span><%- f.l %></span></div>
            <% }) %>
          </div>
        </div>
      </div>

      <aside class="apply-card home-aside">
        <% if (d.availability) { %>
        <p class="avail-line is-<%= d.availability %>"><span class="dot" aria-hidden="true"></span><strong><%= { available: 'Rooms available now', limited: 'Limited availability', waitlist: 'Currently a waiting list' }[d.availability] %></strong><% if (d.availabilityNote) { %><br /><span class="muted"><%= d.availabilityNote %></span><% } %></p>
        <% } %>
        <h3>Visit <%= home.name %></h3>
        <p class="muted" style="margin-top:0;">The best way to judge a home is to see it. We'll show you round and answer your questions — no obligation.</p>
        <ul class="job-facts">
          <li><span>CQC rating</span><span><a href="#cqc"><%= cqcLabel(home) %></a></span></li>
          <li><span>Weekly fees</span><span><% if (from) { %><a href="#fees">from <%= gbp(from) %></a><% } else { %><a href="#fees">see below</a><% } %></span></li>
          <li><span>Beds</span><span><%= home.beds %></span></li>
          <% if (d.managerName) { %><li><span>Manager</span><span><%= d.managerName %></span></li><% } %>
          <li><span>Call</span><span><a href="tel:<%= homeTel %>"><%= homePhone %></a></span></li>
        </ul>
        <a href="#visit" class="btn btn--primary btn--block">Book a visit</a>
        <a href="tel:<%= homeTel %>" class="btn btn--ghost btn--block mt-1">Call the home</a>
      </aside>
    </div>

    <!-- FEES -->
    <div class="home-section" id="fees">
      <h2 class="h2">Fees at <%= home.name %></h2>
      <% var anyFee = FEE_ROWS.some(function(r){ return d.fees && d.fees[r.key]; }); %>
      <% if (anyFee) { %>
      <div class="fee-table-wrap">
        <table class="table fee-table">
          <thead><tr><th scope="col">Type of care</th><th scope="col">Weekly fee from</th></tr></thead>
          <tbody>
            <% FEE_ROWS.forEach(function(r){ if (!d.fees[r.key]) return; %>
            <tr><th scope="row"><%= r.label %></th><td><strong><%= gbp(d.fees[r.key]) %></strong></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="muted fee-note"><% if (d.feesUpdated) { %>Prices correct as of <%= d.feesUpdated %>. <% } %><%= d.feesNote || 'Your exact fee depends on the care needed and the room you choose, and is confirmed in writing after a free assessment.' %></p>
      <% } else { %>
      <p class="lead" style="font-size:1.05rem;">We're updating the published prices for <%= home.name %>. Call <a href="tel:<%= homeTel %>"><%= homePhone %></a> and we'll tell you the current weekly fee straight away — no forms, no obligation.</p>
      <% } %>
      <div class="included-grid">
        <div class="care-panel">
          <h3>Included in the fee</h3>
          <ul class="tick-list">
            <% INCLUDED.forEach(function(i){ %><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><%= i %></span></li><% }) %>
          </ul>
        </div>
        <div class="care-panel">
          <h3>Optional extras (charged separately)</h3>
          <ul class="plain-list">
            <% EXTRAS.forEach(function(i){ %><li><%= i %></li><% }) %>
          </ul>
          <p style="margin:1rem 0 0;"><a class="care-card__link" href="/fees-and-funding">Deposits, fee reviews &amp; funding help →</a></p>
        </div>
      </div>
    </div>

    <!-- CQC -->
    <div class="home-section" id="cqc">
      <h2 class="h2">CQC rating</h2>
      <div class="cqc-box">
        <div class="cqc-box__rating <%= cqcClass(home) %>">
          <span class="cqc-box__label">Care Quality Commission</span>
          <strong><%= cqcLabel(home) %></strong>
          <% if (d.cqcRatedOn) { %><span class="cqc-box__date">Latest report: <%= d.cqcRatedOn %></span><% } %>
        </div>
        <div>
          <p style="margin-top:0;">The Care Quality Commission is the independent regulator of health and social care in England. <% if (cqcLabel(home) === 'Not yet rated') { %><%= home.name %> is registered with the CQC and has not yet been given a rating.<% } else { %>Its inspectors rated <%= home.name %> <strong><%= cqcLabel(home) %></strong>.<% } %></p>
          <a class="btn btn--ghost btn--sm" href="<%= cqcReportUrl(home) %>" target="_blank" rel="noopener">Read the full CQC report ↗</a>
          <% if (d.cqcLocationId) { %>
          <div class="cqc-widget"><script src="https://www.cqc.org.uk/sites/all/modules/custom/cqc_widget/widget.js?data-id=<%= encodeURIComponent(d.cqcLocationId) %>&data-host=https://www.cqc.org.uk&type=location"></script></div>
          <% } %>
        </div>
      </div>
    </div>

    <% if (d.managerName) { %>
    <!-- MANAGER -->
    <div class="home-section manager-card">
      <% if (d.managerPhoto) { %><img class="manager-card__photo" src="<%= d.managerPhoto %>" alt="<%= d.managerName %>" loading="lazy" width="120" height="120" /><% } else { %><div class="manager-card__photo manager-card__initials" aria-hidden="true"><%= d.managerName.split(' ').map(function(p){return p[0];}).join('').slice(0,2) %></div><% } %>
      <div>
        <span class="eyebrow">Meet the home manager</span>
        <h2 class="h2" style="font-size:1.5rem;margin:.3rem 0 .6rem;"><%= d.managerName %></h2>
        <% if (d.managerBio) { %><p style="margin:0;"><%= d.managerBio %></p><% } %>
      </div>
    </div>
    <% } %>

    <% if (d.carehomeUrl) { %>
    <div class="home-section review-strip">
      <div><% if (d.reviewScore) { %><strong class="review-strip__score"><%= d.reviewScore %></strong><span class="muted"> / 10</span><% } %></div>
      <div><strong>Independent reviews on carehome.co.uk</strong><% if (d.reviewCount) { %><br /><span class="muted">from <%= d.reviewCount %> reviews by residents and families</span><% } %></div>
      <a class="btn btn--ghost btn--sm" href="<%= d.carehomeUrl %>" target="_blank" rel="noopener">Read the reviews ↗</a>
    </div>
    <% } %>

    <% if (home.gallery && home.gallery.length) { %>
    <div style="margin-top:3.5rem;">
      <h2 class="h2" style="font-size:1.6rem;">A look around <%= home.name %></h2>
      <div class="gallery-grid">
        <% home.gallery.forEach(function(g, gi){ %>
        <button type="button" class="gallery-item" data-full="<%= photoSrc(g) %>" aria-label="View photo <%= gi+1 %> of <%= home.gallery.length %>" style="background-image:url('<%= photoSrc(g) %>');"></button>
        <% }) %>
      </div>
    </div>
    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button type="button" class="lightbox__close" aria-label="Close">&times;</button>
      <button type="button" class="lightbox__nav lightbox__prev" aria-label="Previous photo">&#8249;</button>
      <img class="lightbox__img" src="" alt="<%= home.name %> photo" />
      <button type="button" class="lightbox__nav lightbox__next" aria-label="Next photo">&#8250;</button>
    </div>
    <% } %>

    <!-- BOOK A VISIT -->
    <div class="home-section visit-section" id="visit">
      <div class="visit-grid">
        <div>
          <span class="eyebrow">Come and see us</span>
          <h2 class="h2">Book a visit to <%= home.name %></h2>
          <p class="lead" style="font-size:1.05rem;"><% if (slots.length) { %>Pick a time that suits you and it’s booked straight away — no waiting for a call back.<% } else { %>Pick a day that suits you and we’ll call or email to confirm.<% } %> There’s no obligation, and you’re welcome to bring family along.</p>
          <div class="directions">
            <h3>Finding us</h3>
            <p style="margin:0 0 .4rem;"><%= home.name %>, <%= home.town %> <%= home.postcode %></p>
            <% if (d.parking) { %><p class="muted" style="margin:0 0 .6rem;"><%= d.parking %></p><% } %>
            <a class="care-card__link" href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(home.name + ', ' + home.town + ' ' + home.postcode) %>" target="_blank" rel="noopener">Get directions ↗</a>
          </div>
        </div>
        <div class="apply-card book-card">
          <% if (booked) { %>
          <div class="booked" role="status">
            <span class="booked__tick" aria-hidden="true">✓</span>
            <h3>You’re booked in, <%= booked.name.split(' ')[0] %></h3>
            <p class="booked__when"><%= booked.when %></p>
            <p class="muted" style="margin:0 0 1rem;"><%= home.name %>, <%= home.town %> <%= home.postcode %></p>
            <div class="booked__actions">
              <a class="btn btn--primary" href="<%= booked.ics %>" download="visit-<%= home.id %>.ics">Add to my calendar</a>
              <a class="btn btn--ghost" href="<%= booked.directions %>" target="_blank" rel="noopener">Get directions ↗</a>
            </div>
            <p class="hint" style="margin-top:1rem;">Need to change it? Call <a href="tel:<%= booked.phone.replace(/\s/g, '') %>"><%= booked.phone %></a>. We look forward to meeting you.</p>
          </div>
          <% } else if (visitSent) { %>
          <div class="alert alert--success" role="status"><strong>Thank you — your visit request is in.</strong><br />The team at <%= home.name %> will be in touch within one working day to confirm a time.</div>
          <% } else if (slots.length) { %>
          <% if (bookError) { %><div class="alert alert--error" role="alert"><%= bookError %></div><% } %>
          <form action="/care-homes/<%= home.id %>/book#visit" method="post" class="book-form" id="bookForm">
            <fieldset class="book-step">
              <legend>1. Choose a day</legend>
              <div class="book-days" role="radiogroup" aria-label="Day" hidden>
                <% slots.forEach(function (day, i) { var chosen = bookForm.slot ? String(bookForm.slot).indexOf(day.date) === 0 : i === 0; %>
                <button type="button" class="book-day<%= chosen ? ' is-on' : '' %>" data-day="<%= day.date %>" aria-pressed="<%= chosen %>">
                  <span class="book-day__dow"><%= day.short.split(' ')[0] %></span>
                  <span class="book-day__num"><%= day.short.split(' ')[1] %></span>
                  <span class="book-day__mon"><%= day.short.split(' ')[2] %></span>
                </button>
                <% }) %>
              </div>
            </fieldset>
            <fieldset class="book-step">
              <legend>2. Choose a time</legend>
              <% slots.forEach(function (day, i) { %>
              <div class="book-times" data-times="<%= day.date %>">
                <p class="book-times__day"><%= day.label %></p>
                <div class="book-times__list">
                  <% day.times.forEach(function (t) { var v = day.date + '|' + t.time; %>
                  <label class="book-time"><input type="radio" name="slot" value="<%= v %>" required <%= bookForm.slot === v ? 'checked' : '' %> /><span><%= t.label %></span></label>
                  <% }) %>
                </div>
              </div>
              <% }) %>
            </fieldset>
            <fieldset class="book-step">
              <legend>3. Your details</legend>
              <div class="field"><label for="b-name">Your name *</label><input type="text" id="b-name" name="name" required autocomplete="name" value="<%= bookForm.name || '' %>" /></div>
              <div class="grid-2">
                <div class="field"><label for="b-phone">Phone</label><input type="tel" id="b-phone" name="phone" autocomplete="tel" value="<%= bookForm.phone || '' %>" /></div>
                <div class="field"><label for="b-email">Email</label><input type="email" id="b-email" name="email" autocomplete="email" value="<%= bookForm.email || '' %>" /></div>
              </div>
              <p class="hint" style="margin-top:-.6rem;">A phone number or email, so we can reach you if anything changes.</p>
              <div class="field"><label for="b-care">Type of care (if known)</label>
                <select id="b-care" name="careType"><option value="">Not sure yet</option><% home.careTypes.forEach(function(c){ %><option <%= bookForm.careType===c?'selected':'' %>><%= c %></option><% }) %></select>
              </div>
              <div class="field"><label for="b-notes">Anything we should know?</label><textarea id="b-notes" name="notes" rows="2"><%= bookForm.notes || '' %></textarea></div>
              <div class="hp" aria-hidden="true"><label for="b-website">Leave this empty</label><input type="text" id="b-website" name="website" tabindex="-1" autocomplete="off" /></div>
            </fieldset>
            <button type="submit" class="btn btn--primary btn--block" id="bookBtn">Confirm my visit</button>
            <p class="hint mt-1" style="text-align:center;">Booked instantly — no obligation. <a href="/privacy">Privacy policy</a></p>
          </form>
          <details class="book-other"<%= visitError ? ' open' : '' %>>
            <summary>None of these times work? Ask for a different time</summary>
            <% if (visitError) { %><div class="alert alert--error" role="alert"><%= visitError %></div><% } %>
          <form action="/care-homes/<%= home.id %>/visit#visit" method="post">
            <div class="grid-2">
              <div class="field"><label for="v-date">Preferred day</label><input type="date" id="v-date" name="date" value="<%= visitForm.date || '' %>" min="<%= new Date().toISOString().slice(0,10) %>" /></div>
              <div class="field"><label for="v-time">Time</label>
                <select id="v-time" name="time">
                  <% ['Any time','Morning','Afternoon','Evening (after 5pm)','Weekend'].forEach(function(t){ %><option <%= visitForm.time===t?'selected':'' %>><%= t %></option><% }) %>
                </select>
              </div>
            </div>
            <div class="field"><label for="v-name">Your name *</label><input type="text" id="v-name" name="name" required autocomplete="name" value="<%= visitForm.name || '' %>" /></div>
            <div class="grid-2">
              <div class="field"><label for="v-phone">Phone</label><input type="tel" id="v-phone" name="phone" autocomplete="tel" value="<%= visitForm.phone || '' %>" /></div>
              <div class="field"><label for="v-email">Email</label><input type="email" id="v-email" name="email" autocomplete="email" value="<%= visitForm.email || '' %>" /></div>
            </div>
            <div class="field"><label for="v-care">Type of care (if known)</label>
              <select id="v-care" name="careType"><option value="">Not sure yet</option><% home.careTypes.forEach(function(c){ %><option <%= visitForm.careType===c?'selected':'' %>><%= c %></option><% }) %></select>
            </div>
            <div class="field"><label for="v-notes">Anything we should know?</label><textarea id="v-notes" name="notes" rows="3"><%= visitForm.notes || '' %></textarea></div>
            <div class="hp" aria-hidden="true"><label for="v-website">Leave this empty</label><input type="text" id="v-website" name="website" tabindex="-1" autocomplete="off" /></div>
            <button type="submit" class="btn btn--primary btn--block">Send my request</button>
            <p class="hint mt-1" style="text-align:center;">We'll only use your details to arrange your visit. <a href="/privacy">Privacy policy</a></p>
          </form>
          </details>
          <% } else { %>
          <% if (visitError) { %><div class="alert alert--error" role="alert"><%= visitError %></div><% } %>
          <form action="/care-homes/<%= home.id %>/visit#visit" method="post">
            <div class="grid-2">
              <div class="field"><label for="v-date">Preferred day</label><input type="date" id="v-date" name="date" value="<%= visitForm.date || '' %>" min="<%= new Date().toISOString().slice(0,10) %>" /></div>
              <div class="field"><label for="v-time">Time</label>
                <select id="v-time" name="time">
                  <% ['Any time','Morning','Afternoon','Evening (after 5pm)','Weekend'].forEach(function(t){ %><option <%= visitForm.time===t?'selected':'' %>><%= t %></option><% }) %>
                </select>
              </div>
            </div>
            <div class="field"><label for="v-name">Your name *</label><input type="text" id="v-name" name="name" required autocomplete="name" value="<%= visitForm.name || '' %>" /></div>
            <div class="grid-2">
              <div class="field"><label for="v-phone">Phone</label><input type="tel" id="v-phone" name="phone" autocomplete="tel" value="<%= visitForm.phone || '' %>" /></div>
              <div class="field"><label for="v-email">Email</label><input type="email" id="v-email" name="email" autocomplete="email" value="<%= visitForm.email || '' %>" /></div>
            </div>
            <div class="field"><label for="v-care">Type of care (if known)</label>
              <select id="v-care" name="careType"><option value="">Not sure yet</option><% home.careTypes.forEach(function(c){ %><option <%= visitForm.careType===c?'selected':'' %>><%= c %></option><% }) %></select>
            </div>
            <div class="field"><label for="v-notes">Anything we should know?</label><textarea id="v-notes" name="notes" rows="3"><%= visitForm.notes || '' %></textarea></div>
            <div class="hp" aria-hidden="true"><label for="v-website">Leave this empty</label><input type="text" id="v-website" name="website" tabindex="-1" autocomplete="off" /></div>
            <button type="submit" class="btn btn--primary btn--block">Request my visit</button>
            <p class="hint mt-1" style="text-align:center;">We'll only use your details to arrange your visit. <a href="/privacy">Privacy policy</a></p>
          </form>
          <% } %>
        </div>
      </div>
    </div>

    <% if (jobs && jobs.length) { %>
    <div style="margin-top:3.5rem;">
      <h2 class="h2" style="font-size:1.6rem;">Careers at <%= home.name %></h2>
      <div class="job-list" style="margin-top:1.2rem;">
        <% jobs.forEach(function(job){ %>
        <a class="job-card" href="/careers/<%= job.id %>">
          <div class="job-card__top">
            <div><span class="badge badge--service"><%= job.service %></span><h3 style="margin-top:0.6rem;"><%= job.title %></h3></div>
            <span class="btn btn--ghost btn--sm">View job</span>
          </div>
          <p class="muted" style="margin:0.5rem 0 0;"><%= job.summary %></p>
        </a>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
