<%- include('../partials/admin-header') %>
<% var d = home.details; function sel(a,b){ return a===b ? 'selected' : ''; } %>

<div class="hub-crumb"><a href="/admin/homes">Homes</a> › <%= isNew ? 'Add a home' : home.name %></div>
<div class="hub-head"><div>
<h1 class="hub-h1"><%= isNew ? 'Add a home' : home.name %></h1>
</div>
<% if (!isNew && !home.details.archived) { %><div class="row-actions">
  <a class="btn btn--sm btn--muted" href="/care-homes/<%= home.id %>" target="_blank" rel="noopener">View on website ↗</a>
  <% if (canHomes) { %><form action="/admin/homes/<%= home.id %>/archive" method="post" class="inline-form" data-confirm="Make <%= home.name.replace(/"/g, '') %> a draft? Families won’t see it until you make it live again."><input type="hidden" name="back" value="edit" /><button class="btn btn--sm btn--muted">Make draft</button></form><% } %>
</div><% } %>
</div>
<% if (error) { %><div class="alert alert--error" role="alert"><%= error %></div><% } %>
<% if (!isNew && home.details.archived) { %><div class="hub-notice hub-notice--warn hub-notice--action"><span><strong>Draft</strong> — families can’t see this home until you make it live.</span><% if (canHomes) { %><form action="/admin/homes/<%= home.id %>/restore" method="post" class="inline-form"><input type="hidden" name="back" value="edit" /><button class="btn btn--primary btn--sm">Make live</button></form><% } %></div><% } %>

<form action="/admin/homes/<%= isNew ? 'new' : home.id %>" method="post" class="admin-form" enctype="multipart/form-data">

  <fieldset class="hub-fieldset" <%= canHomes ? "" : "disabled" %>>
  <div class="panel" style="margin-top:1.5rem;">
    <div class="panel__head"><h2>Basics</h2></div>
    <div class="panel__body">
      <div class="grid-2">
        <div class="field"><label for="name">Home name<%= isNew ? ' *' : '' %></label><input type="text" id="name" name="name" value="<%= home.name %>" required /></div>
        <div class="field"><label for="phone">Direct phone number for this home</label><input type="tel" id="phone" name="phone" value="<%= d.phone %>" placeholder="Leave blank to use <%= SITE.phone %>" /></div>
      </div>
      <div class="field"><label for="email">Email address for this home</label><input type="email" id="email" name="email" value="<%= d.email %>" placeholder="Leave blank to use <%= SITE.email %>" style="max-width:28rem;" /></div>
      <div class="field"><label for="blurb">Short description</label><textarea id="blurb" name="blurb" rows="3"><%= home.blurb %></textarea></div>
    </div>
  </div>

  <div class="panel" id="sec-address">
    <div class="panel__head"><h2>Address</h2></div>
    <div class="panel__body">
      <div class="field"><label for="address">Address</label><textarea id="address" name="address" rows="2" style="min-height:4.5rem;" autocomplete="street-address" placeholder="e.g. 12 Victoria Road"><%= d.address %></textarea></div>
      <div class="grid-2">
        <div class="field"><label for="town">Town<%= isNew ? ' *' : '' %></label><input id="town" name="town" required autocomplete="address-level2" value="<%= home.town %>" /></div>
        <div class="field"><label for="postcode">Postcode</label><input id="postcode" name="postcode" autocomplete="postal-code" value="<%= home.postcode %>" style="max-width:12rem;" /></div>
      </div>
    </div>
  </div>

  <div class="panel">
    <div class="panel__head"><h2>Care</h2></div>
    <div class="panel__body">
      <div class="grid-2">
        <div class="field"><label for="beds">Number of beds</label><input type="number" id="beds" name="beds" min="1" value="<%= home.beds %>" /></div>
        <div class="field">
          <span class="label">Types of care offered</span>
          <div class="check-grid">
            <% careTypes.forEach(function(c){ %><label><input type="checkbox" name="careTypes" value="<%= c %>" <%= home.careTypes.indexOf(c) > -1 ? 'checked' : '' %> /> <%= c %></label><% }) %>
          </div>
        </div>
      </div>
      <% var spec = home.specialisms || []; var otherSpec = spec.filter(function (s) { return specialistCare.indexOf(s) === -1; }); %>
      <div class="field">
        <span class="label">Specialist care</span>
        <div class="check-grid check-grid--3">
          <% specialistCare.forEach(function(s){ %><label><input type="checkbox" name="specialisms" value="<%= s %>" <%= spec.indexOf(s) > -1 ? 'checked' : '' %> /> <%= s %></label><% }) %>
        </div>
      </div>
      <div class="field"><label for="specialismsOther">Add specialist care not listed</label><input id="specialismsOther" name="specialismsOther" value="<%= otherSpec.join(', ') %>" placeholder="e.g. Korsakoff syndrome, Spinal injury" /></div>
    </div>
  </div>

  <div class="panel" id="facilities">
    <div class="panel__head"><h2>Facilities</h2></div>
    <div class="panel__body">
      <input type="hidden" name="facilitiesSection" value="1" />
      <% var myFac = homeFacilityNames(home); %>
      <% FACILITY_GROUPS.forEach(function (g) { var items = facilityList.filter(function (x) { return x.group === g.name; }); if (!items.length) return; %>
      <div class="field">
        <span class="label"><%= g.name %></span>
        <div class="check-grid check-grid--3">
          <% items.forEach(function (x) { %><label><input type="checkbox" name="facilities" value="<%= x.name %>" <%= myFac.indexOf(x.name) > -1 ? 'checked' : '' %> /> <%= x.name %></label><% }) %>
        </div>
      </div>
      <% }) %>
    </div>
  </div>

  <fieldset class="hub-fieldset" <%= canPhotos ? "" : "disabled" %>>
  <div class="panel" id="photos">
    <div class="panel__head"><h2>Photos</h2></div>
    <div class="panel__body">
      <div class="home-photos">
        <div class="home-photos__main">
          <span class="label">Main photo (outside the home)</span>
          <% if (home.photo) { %><img src="<%= photoSrc(home.photo) %>" alt="Current main photo of <%= home.name %>" /><% } else { %><div class="home-photos__none">No photo yet</div><% } %>
          <label for="photoFile" class="label" style="margin-top:.5rem;">Replace it</label>
          <input type="file" id="photoFile" name="photoFile" accept="image/jpeg,image/png,image/webp,image/avif" />
        </div>
        <div>
          <span class="label">Gallery</span>
          <div class="home-photos__grid">
            <% (home.gallery || []).forEach(function (g, i) { %>
            <label class="home-photos__item"><img src="<%= photoSrc(g) %>" alt="Gallery photo <%= i + 1 %>" loading="lazy" /><span><input type="checkbox" name="keepGallery" value="<%= g %>" checked /> Keep</span></label>
            <% }) %>
          </div>
          <label for="galleryFiles" class="label" style="margin-top:.5rem;">Add photos</label>
          <input type="file" id="galleryFiles" name="galleryFiles" multiple accept="image/jpeg,image/png,image/webp,image/avif" />
          <span class="hint">JPEG, PNG or WebP, up to 10 MB each.</span>
        </div>
      </div>
    </div>
  </div>
  <input type="hidden" name="photosSection" value="1" />
  </fieldset>

  </fieldset>
  <fieldset class="hub-fieldset" <%= canHomes ? "" : "disabled" %>>
  <div class="panel" id="visiting">
    <div class="panel__head"><h2>Visiting times</h2></div>
    <div class="panel__body">
      <label class="checkbox" style="display:flex;margin-bottom:1rem;"><input type="checkbox" name="visitsEnabled" data-reveal="visitSettings" <%= visitSettings.enabled ? 'checked' : '' %> /> Let families book visits online</label>
      <div id="visitSettings"<%= visitSettings.enabled ? '' : ' hidden' %>>
      <div class="field"><span class="label">Visiting days</span>
        <div class="check-grid" style="grid-template-columns:repeat(auto-fill,minmax(120px,1fr));">
          <% [1,2,3,4,5,6,0].forEach(function (d) { %><label><input type="checkbox" name="visitDays" value="<%= d %>" <%= visitSettings.days.indexOf(d) > -1 ? 'checked' : '' %> /> <%= DAY_NAMES[d] %></label><% }) %>
        </div>
      </div>
      <div class="field"><label for="visitTimes">Visit start times</label><input id="visitTimes" name="visitTimes" value="<%= visitSettings.times.map(timeLabel).join(', ') %>" /><span class="hint">e.g. 10am, 11am, 2pm, 3:30pm</span></div>
      <div class="grid-2">
        <div class="field"><label for="visitPerSlot">Visits at the same time</label><input id="visitPerSlot" name="visitPerSlot" type="number" min="1" max="10" value="<%= visitSettings.perSlot %>" /></div>
        <div class="field"><label for="visitNotice">Notice needed (hours)</label><input id="visitNotice" name="visitNotice" type="number" min="0" max="336" value="<%= visitSettings.noticeHours %>" /></div>
      </div>
      <div class="grid-2">
        <div class="field"><label for="visitWeeks">How far ahead (weeks)</label><input id="visitWeeks" name="visitWeeks" type="number" min="1" max="12" value="<%= visitSettings.weeksAhead %>" /></div>
        <div class="field"><label for="visitClosed">Dates with no visits</label><textarea id="visitClosed" name="visitClosed" rows="2" placeholder="2026-12-25"><%= visitSettings.closedDates.join('\n') %></textarea><span class="hint">One per line</span></div>
      </div>
      </div>
    </div>
  </div>
  </fieldset>
  <% if (seeAvail) { %>
  <fieldset class="hub-fieldset" <%= canAvail ? "" : "disabled" %>>
  <div class="panel" id="sec-availability">
    <div class="panel__head"><h2>Rooms</h2></div>
    <div class="panel__body">
      <div class="grid-2">
        <div class="field"><label for="availability">Does this home have free rooms?</label>
          <select id="availability" name="availability">
            <option value="" <%= sel(d.availability,'') %>>Don’t say on the website</option>
            <option value="available" <%= sel(d.availability,'available') %>>Yes — rooms free now</option>
            <option value="limited" <%= sel(d.availability,'limited') %>>Only one or two free</option>
            <option value="waitlist" <%= sel(d.availability,'waitlist') %>>No — full, taking a waiting list</option>
          </select>
        </div>
        <div class="field"><label for="availabilityNote">Extra detail for families (optional)</label><input type="text" id="availabilityNote" name="availabilityNote" value="<%= d.availabilityNote %>" placeholder="e.g. Two en-suite rooms free from October" /></div>
      </div>
    </div>
  </div>

  </fieldset>
  <% } %>
  <% if (seeFees) { %>
  <fieldset class="hub-fieldset" <%= canFees ? "" : "disabled" %>>
  <div class="panel" id="fees">
    <div class="panel__head"><h2>Weekly fees ("from" prices)</h2></div>
    <div class="panel__body">
      <div class="grid-2">
        <div class="field"><label for="feeResidential">Residential care £/week</label><input type="text" inputmode="numeric" id="feeResidential" name="feeResidential" value="<%= d.fees.residential || '' %>" /></div>
        <div class="field"><label for="feeNursing">Nursing care £/week</label><input type="text" inputmode="numeric" id="feeNursing" name="feeNursing" value="<%= d.fees.nursing || '' %>" /></div>
        <div class="field"><label for="feeDementia">Dementia care £/week</label><input type="text" inputmode="numeric" id="feeDementia" name="feeDementia" value="<%= d.fees.dementia || '' %>" /></div>
        <div class="field"><label for="feeRespite">Respite £/week</label><input type="text" inputmode="numeric" id="feeRespite" name="feeRespite" value="<%= d.fees.respite || '' %>" /></div>
      </div>
      <div class="grid-2">
        <div class="field"><label for="feesUpdated">Prices correct as of</label><input type="text" id="feesUpdated" name="feesUpdated" value="<%= d.feesUpdated %>" placeholder="e.g. September 2026" /></div>
        <div class="field"><label for="feesNote">Note shown under the prices</label><input type="text" id="feesNote" name="feesNote" value="<%= d.feesNote %>" placeholder="e.g. Nursing fee shown before NHS-funded nursing care (FNC)" /></div>
      </div>
      <div class="field" style="margin-top:.5rem;">
        <span class="label">What the fee covers</span>
        <input type="hidden" name="feeItemsSection" value="1" />
        <div class="fee-items">
          <% feeItems.forEach(function (it, n) { var how = (d.feeItems && d.feeItems[it.name]) || it.usually; %>
          <div class="fee-item">
            <span><%= it.name %></span>
            <select name="fee_<%= n %>" aria-label="<%= it.name %>">
              <option value="included" <%= how === 'included' ? 'selected' : '' %>>Included</option>
              <option value="extra" <%= how === 'extra' ? 'selected' : '' %>>Extra charge</option>
              <option value="no" <%= how === 'no' ? 'selected' : '' %>>Not offered</option>
            </select>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  </fieldset>
  <% } %>
  <fieldset class="hub-fieldset" <%= canHomes ? "" : "disabled" %>>
  <div class="panel" id="sec-cqc">
    <div class="panel__head"><h2>CQC rating</h2></div>
    <div class="panel__body">
      <div class="grid-2">
        <div class="field"><label for="cqc">Overall rating</label>
          <select id="cqc" name="cqc">
            <% ['Outstanding','Good','Requires improvement','Inadequate','Registered'].forEach(function(r){ %><option value="<%= r %>" <%= sel(home.cqc, r) %>><%= r === 'Registered' ? 'Not yet rated' : r %></option><% }) %>
          </select>
        </div>
        <div class="field"><label for="cqcRatedOn">Date of latest report</label><input type="text" id="cqcRatedOn" name="cqcRatedOn" value="<%= d.cqcRatedOn %>" placeholder="e.g. 12 March 2026" /></div>
      </div>
      <div class="field"><label for="cqcLocationId">CQC location ID</label><input type="text" id="cqcLocationId" name="cqcLocationId" value="<%= d.cqcLocationId %>" placeholder="e.g. 1-123456789" /></div>
    </div>
  </div>

  </fieldset>
  <fieldset class="hub-fieldset" <%= canHomes ? "" : "disabled" %>>
  <div class="panel" id="manager">
    <div class="panel__head"><h2>Home manager</h2></div>
    <div class="panel__body">
      <div class="field manager-photo">
        <label for="managerId">Choose from the staff directory</label>
        <% var mgr = d.managerId && staff.find(function (u) { return u.id === d.managerId; }); %>
        <select id="managerId" name="managerId" style="max-width:28rem;">
          <option value="">No manager shown</option>
          <% if (!d.managerId && d.managerName) { %><option value="keep" selected><%= d.managerName %> (not in the staff directory)</option><% } %>
          <% staff.forEach(function (u) { %><option value="<%= u.id %>" <%= u.id === d.managerId ? 'selected' : '' %>><%= u.name %><%= u.title ? ' — ' + u.title : '' %></option><% }) %>
        </select>
        <% if (mgr && mgr.photoKey) { %><img src="/admin/staff-photo/<%= mgr.id %>" alt="Photo of <%= mgr.name %>" width="96" height="96" /><% } %>
        <% if (mgr && (!mgr.photoKey || !mgr.photoConsent)) { %><span class="hint">No photo on the website until <%= mgr.name.split(' ')[0] %> uploads one in My account.</span><% } %>
      </div>
      <div class="field"><label for="managerBio">A few words from or about them</label><textarea id="managerBio" name="managerBio" rows="3"><%= d.managerBio %></textarea></div>
    </div>
  </div>

  </fieldset>
  <fieldset class="hub-fieldset" <%= canHomes ? "" : "disabled" %>>
  <div class="panel">
    <div class="panel__head"><h2>Reviews</h2></div>
    <div class="panel__body">
      <div class="field"><label for="carehomeUrl">Link to this home on carehome.co.uk</label><input type="url" id="carehomeUrl" name="carehomeUrl" value="<%= d.carehomeUrl %>" placeholder="https://www.carehome.co.uk/carehome.cfm/searchazref/…" /></div>
      <div class="grid-2">
        <div class="field"><label for="reviewScore">Score shown there (out of 10)</label><input type="text" id="reviewScore" name="reviewScore" value="<%= d.reviewScore %>" placeholder="e.g. 9.6" /></div>
        <div class="field"><label for="reviewCount">Number of reviews shown there</label><input type="text" id="reviewCount" name="reviewCount" value="<%= d.reviewCount %>" placeholder="e.g. 42" /></div>
      </div>
      <div class="field"><label for="googleUrl">Link to this home on Google Maps</label><input type="url" id="googleUrl" name="googleUrl" value="<%= d.googleUrl %>" placeholder="https://maps.app.goo.gl/…" /></div>
      <div class="field">
        <span class="label">Reviews from families</span>
        <div class="quotes">
          <% (d.testimonials || []).concat([{}, {}]).forEach(function (t, n) { %>
          <div class="quote-row">
            <textarea name="tq_<%= n %>" rows="2" maxlength="600" aria-label="Review <%= n + 1 %>" <%- t.quote ? '' : 'placeholder="e.g. The staff are fantastic and always make us feel welcome."' %>><%= t.quote || '' %></textarea>
            <div class="quote-row__meta">
              <input name="tname_<%= n %>" value="<%= t.name || '' %>" maxlength="40" aria-label="Name" placeholder="Name, e.g. Andrea G" />
              <input name="tby_<%= n %>" value="<%= t.by || '' %>" maxlength="80" aria-label="Who they are" placeholder="e.g. Daughter of resident" />
              <select name="tstars_<%= n %>" aria-label="Stars"><option value="">Stars</option><% [5, 4, 3, 2, 1].forEach(function (k) { %><option value="<%= k %>" <%= +t.stars === k ? 'selected' : '' %>><%= '★'.repeat(k) %></option><% }) %></select>
              <input type="month" name="tdate_<%= n %>" value="<%= (t.date || '').slice(0, 7) %>" aria-label="Month" />
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <div class="panel">
    <div class="panel__head"><h2>Getting here</h2></div>
    <div class="panel__body">
      <div class="field"><label for="visitingHours">Visiting hours</label><input id="visitingHours" name="visitingHours" value="<%= d.visitingHours %>" placeholder="e.g. Any time, or 10am – 8pm daily" style="max-width:28rem;" /></div>
      <div class="field"><label for="parking">Parking and travel</label><textarea id="parking" name="parking" rows="2" style="min-height:4.5rem;" placeholder="e.g. Free visitor parking on site. 5 minutes' walk from East Croydon station."><%= d.parking %></textarea></div>
    </div>
  </div>

  </fieldset>
  <div style="display:flex;gap:.8rem;margin:1.5rem 0 3rem;">
    <% if (canHomes || canFees || canAvail) { %><button type="submit" class="btn btn--primary"><%= isNew ? 'Add home' : 'Save changes' %></button><% } %>
    <a href="/admin/homes" class="btn btn--muted">Cancel</a>
  </div>
</form>

<% if (!isNew && canHomes && me.homes === 'all') { %>
<div class="panel" style="margin-bottom:3rem;">
  <div class="panel__head"><h2>Delete this home</h2></div>
  <div class="panel__body">
    <% if (!home.details.archived) { %><p class="muted" style="margin:0;">Make the home a draft first.</p>
    <% } else if (jobCount) { %><p class="muted" style="margin:0;"><%= home.name %> still has <%= jobCount %> job<%= jobCount === 1 ? '' : 's' %> attached. Delete or move <%= jobCount === 1 ? 'it' : 'them' %> first.</p>
    <% } else { %>
    <form action="/admin/homes/<%= home.id %>/delete" method="post" class="hub-inline" data-confirm="Delete <%= home.name.replace(/"/g, '') %> for good? This can’t be undone.">
      <label for="del-confirm" class="hint">Type the home’s name to confirm.</label>
      <input id="del-confirm" name="confirm" autocomplete="off" style="max-width:220px;" required />
      <button class="btn btn--danger btn--sm">Delete home</button>
    </form>
    <% } %>
  </div>
</div>
<% } %>

<%- include('../partials/admin-footer') %>
