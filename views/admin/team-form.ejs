<%- include('../partials/admin-header') %>
<% var m = member || {}; %>

<div class="hub-crumb"><a href="/admin/team">Our team</a> › <%= mode === 'edit' ? m.name : 'Add a team member' %></div>
<h1 class="hub-h1"><%= mode === 'edit' ? 'Edit ' + m.name : 'Add a team member' %></h1>

<form action="/admin/team<%= mode === 'edit' ? '/' + m.id : '' %>" method="post" class="admin-form" enctype="multipart/form-data">
  <div class="panel">
    <div class="panel__body">
      <div class="grid-2">
        <div class="field"><label for="name">Name</label><input type="text" id="name" name="name" value="<%= m.name || '' %>" required maxlength="80" /></div>
        <div class="field"><label for="role">Role</label><input type="text" id="role" name="role" value="<%= m.role || '' %>" maxlength="100" placeholder="e.g. Home manager, Albany Lodge" /></div>
      </div>
      <div class="field"><label for="bio">A few words about them (optional)</label><textarea id="bio" name="bio" rows="3" maxlength="600"><%= m.bio || '' %></textarea></div>
      <div class="field manager-photo">
        <span class="label">Photo</span>
        <% if (m.photo) { %><img src="<%= photoSrc(m.photo) %>" alt="Current photo of <%= m.name %>" width="96" height="96" /><% } %>
        <label for="photoFile" class="label"><%= m.photo ? 'Replace it' : 'Add a photo' %></label>
        <input type="file" id="photoFile" name="photoFile" accept="image/jpeg,image/png,image/webp,image/avif" />
        <% if (m.photo) { %><label class="check-inline"><input type="checkbox" name="removePhoto" value="1" /> Remove the photo (shows their initials instead)</label><% } %>
        <span class="hint">JPEG, PNG or WebP, up to 10 MB.</span>
      </div>
      <div class="field" style="max-width:160px;"><label for="order">Position on the page</label><input type="number" id="order" name="order" value="<%= m.order || '' %>" min="0" /></div>
    </div>
  </div>
  <div style="display:flex;gap:.8rem;margin:1.5rem 0 3rem;">
    <button type="submit" class="btn btn--primary"><%= mode === 'edit' ? 'Save changes' : 'Add to the page' %></button>
    <a href="/admin/team" class="btn btn--muted">Cancel</a>
  </div>
</form>

<%- include('../partials/admin-footer') %>
