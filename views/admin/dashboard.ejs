<%- include('../partials/admin-header') %>

<div class="hub-head">
  <div>
    <h1 class="hub-h1">Jobs</h1>
    <p class="muted">Vacancies on the careers site<%= me.homes === 'all' ? '' : ' for ' + homesLabel(me) %>. Anything open appears on the website straight away.</p>
  </div>
  <% if (canEdit) { %><a href="/admin/jobs/new" class="btn btn--primary">+ Post a job</a><% } %>
</div>

<div class="hub-card">
  <% if (jobs.length) { %>
  <div class="table-wrap">
  <table class="table">
    <thead><tr><th>Role</th><th>Home</th><th>Status</th><th>Applications</th><th>Posted</th><th></th></tr></thead>
    <tbody>
      <% jobs.forEach(function(job){ var h = hubHomes.find(function (x) { return x.id === job.homeId; }); %>
      <tr>
        <td>
          <strong><%= job.title %></strong>
          <% if (job.featured) { %><span class="badge badge--featured" style="margin-left:.4rem;">Featured</span><% } %>
          <div class="muted" style="font-size:.85rem;"><%= job.employmentType %><%= job.salary ? ' · ' + job.salary : '' %></div>
        </td>
        <td><%= h ? h.name : (job.location || 'Head office') %></td>
        <td><span class="badge <%= job.status === 'open' ? 'badge--open' : 'badge--closed' %>"><%= job.status %></span></td>
        <td>
          <% if (!canApps) { %><span class="muted">—</span>
          <% } else if (counts[job.id]) { %><a href="/admin/applications?job=<%= job.id %>"><strong><%= counts[job.id] %></strong> view</a>
          <% } else { %><span class="muted">0</span><% } %>
        </td>
        <td class="muted" style="font-size:.85rem;"><%= new Date(job.postedAt).toLocaleDateString('en-GB') %></td>
        <td>
          <% if (canEdit) { %>
          <div class="row-actions">
            <a href="/admin/jobs/<%= job.id %>/edit" class="btn btn--sm btn--ghost">Edit</a>
            <form action="/admin/jobs/<%= job.id %>/toggle" method="post" class="inline-form">
              <button class="btn btn--sm btn--muted"><%= job.status === 'open' ? 'Close' : 'Reopen' %></button>
            </form>
            <form action="/admin/jobs/<%= job.id %>/delete" method="post" class="inline-form" data-confirm="Delete this vacancy and all its applications? This can’t be undone.">
              <button class="btn btn--sm btn--danger">Delete</button>
            </form>
          </div>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <% } else { %>
  <div class="hub-empty">
    <p class="muted">No vacancies yet.</p>
    <% if (canEdit) { %><a href="/admin/jobs/new" class="btn btn--primary">Post your first job</a><% } %>
  </div>
  <% } %>
</div>

<%- include('../partials/admin-footer') %>
