<%- include('../partials/admin-header') %>

<h1 class="admin-h1">Staff accounts</h1>
<p class="muted">Everyone who can sign in to the backoffice. Each person gets their own account, so it's clear who did what.</p>

<% if (error) { %><div class="alert alert--error" style="margin-top:1.25rem;"><%= error %></div><% } %>
<% if (notice) { %><div class="alert alert--success" style="margin-top:1.25rem;"><%= notice %></div><% } %>

<div class="panel" style="margin-top:1.5rem;">
  <div class="panel__head"><h2><%= users.length %> account<%= users.length===1?'':'s' %></h2></div>
  <% if (users.length) { %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Name</th><th>Email</th><th>Access</th><th>Last signed in</th><th></th></tr></thead>
      <tbody>
        <% users.forEach(function(u){ %>
        <tr>
          <td><strong><%= u.name || '—' %></strong></td>
          <td><%= u.email %></td>
          <td><span class="kind-tag <%= u.role === 'owner' ? 'kind-tag--callback' : '' %>"><%= u.role === 'owner' ? 'Owner' : 'Staff' %></span></td>
          <td class="muted" style="font-size:.85rem;white-space:nowrap;">
            <%= u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleDateString('en-GB') : 'Never' %>
          </td>
          <td>
            <form action="/admin/users/<%= u.id %>/delete" method="post" class="inline-form"
                  onsubmit="return confirm('Remove <%= u.email %>? They will not be able to sign in again.');">
              <button type="submit" class="btn btn--sm btn--danger">Remove</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <div class="panel__body">
    <div class="empty-state">
      <h3>No staff accounts yet</h3>
      <p>You're signed in with the hosting login. Add accounts below so each person has their own, then that shared login is only a way back in if someone gets locked out.</p>
    </div>
  </div>
  <% } %>
</div>

<div class="panel panel--form" style="margin-top:1.5rem;">
  <div class="panel__head"><h2>Add someone</h2></div>
  <div class="panel__body">
    <form action="/admin/users" method="post" class="admin-form">
      <div class="grid-2">
        <div class="field">
          <label for="name">Their name</label>
          <input type="text" id="name" name="name" placeholder="e.g. Priya Sharma" />
        </div>
        <div class="field">
          <label for="email">Email *</label>
          <input type="email" id="email" name="email" required placeholder="priya@venzacare.co.uk" />
        </div>
      </div>
      <div class="grid-2">
        <div class="field">
          <label for="password">First password *</label>
          <input type="text" id="password" name="password" required minlength="10" placeholder="At least 10 characters, with a number" />
          <span class="hint">Send it to them however you like, and ask them to change it once they're in.</span>
        </div>
        <div class="field">
          <label for="role">Access level</label>
          <select id="role" name="role">
            <option value="staff">Staff — vacancies, applications, enquiries, homes</option>
            <option value="owner">Owner — all of that, plus accounts and data requests</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn btn--primary">Create account</button>
    </form>
  </div>
</div>

<div class="panel" style="margin-top:1.5rem;">
  <div class="panel__head"><h2>Recent activity</h2></div>
  <% if (audit.length) { %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>When</th><th>Who</th><th>What</th></tr></thead>
      <tbody>
        <% audit.forEach(function(a){ %>
        <tr>
          <td class="muted" style="font-size:.85rem;white-space:nowrap;">
            <%= new Date(a.createdAt).toLocaleDateString('en-GB') %>
            <%= new Date(a.createdAt).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'}) %>
          </td>
          <td><%= a.actor || '—' %></td>
          <td><%= a.action %><% if (a.detail) { %> <span class="muted">— <%= a.detail %></span><% } %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <div class="panel__body"><p class="muted" style="margin:0;">Nothing recorded yet.</p></div>
  <% } %>
</div>

<%- include('../partials/admin-footer') %>
