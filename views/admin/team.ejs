<%- include('../partials/admin-header') %>

<div class="hub-head">
  <div>
    <h1 class="hub-h1">Our team</h1>
  </div>
  <% if (canEdit) { %><a href="/admin/team/new" class="btn btn--primary">+ Add a team member</a><% } %>
</div>

<% var live = !hidden && team.length; %>
<div class="hub-card team-visibility">
  <div>
    <strong>On the website:</strong>
    <% if (live) { %><span class="hub-pill hub-pill--ok">Showing</span>
    <% } else if (hidden) { %><span class="hub-pill hub-pill--warn">Hidden</span>
    <% } else { %><span class="hub-pill hub-pill--plain">Hidden until you add someone</span><% } %>
  </div>
  <form action="/admin/team/visibility" method="post" class="inline-form">
    <input type="hidden" name="show" value="<%= hidden ? '1' : '0' %>" />
    <button type="submit" class="btn btn--sm <%= hidden ? 'btn--primary' : 'btn--ghost' %>"><%= hidden ? 'Show on website' : 'Hide from website' %></button>
  </form>
</div>

<div class="hub-card">
  <% if (team.length) { %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Order</th><th>Photo</th><th>Name</th><th>Role</th><th></th></tr></thead>
      <tbody>
        <% team.forEach(function (m) { %>
        <tr>
          <td class="muted"><%= m.order || '—' %></td>
          <td><% if (m.photo) { %><img class="team-thumb" src="<%= photoSrc(m.photo) %>" alt="" width="44" height="44" /><% } else { %><span class="muted">None</span><% } %></td>
          <td><strong><%= m.name %></strong></td>
          <td><%= m.role || '' %></td>
          <td style="white-space:nowrap;">
            <% if (canEdit) { %>
            <a href="/admin/team/<%= m.id %>/edit" class="btn btn--muted btn--sm">Edit</a>
            <form action="/admin/team/<%= m.id %>/delete" method="post" class="inline-form" data-confirm="Remove <%= m.name.replace(/"/g, '') %> from the Our team page?">
              <button type="submit" class="btn btn--muted btn--sm">Remove</button>
            </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <p class="muted">No one on the Our team page yet.<% if (canEdit) { %> <a href="/admin/team/new">Add the first team member</a>.<% } %></p>
  <% } %>
</div>

<%- include('../partials/admin-footer') %>
