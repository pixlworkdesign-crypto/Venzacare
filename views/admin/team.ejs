<%- include('../partials/admin-header') %>

<div class="hub-head">
  <div>
    <h1 class="hub-h1">Our team</h1>
  </div>
  <% if (canEdit) { %><a href="/admin/team/new" class="btn btn--ghost">+ Add someone not in the directory</a><% } %>
</div>

<% if (canEdit) { %>
<form action="/admin/team/from-directory" method="post" class="hub-card team-pick">
  <label for="pick-user" class="label">Add from the staff directory</label>
  <div class="team-pick__row">
    <select id="pick-user" name="userId" required <%= staff.length ? '' : 'disabled' %>>
      <option value=""><%= staff.length ? 'Choose a person…' : 'Everyone in the directory is already on the page' %></option>
      <% staff.forEach(function (u) { %><option value="<%= u.id %>"><%= u.name %><%= u.title ? ' — ' + u.title : '' %></option><% }) %>
    </select>
    <button type="submit" class="btn btn--primary" <%= staff.length ? '' : 'disabled' %>>Add to the page</button>
  </div>
</form>
<% } %>

<% var live = !hidden && team.length; %>
<div class="hub-card team-visibility">
  <div>
    <strong>On the website:</strong>
    <% if (live) { %><span class="hub-pill hub-pill--ok">Showing</span>
    <% } else if (hidden) { %><span class="hub-pill hub-pill--warn">Hidden</span>
    <% } else { %><span class="hub-pill hub-pill--plain">Hidden until you add someone</span><% } %>
  </div>
  <form action="/admin/team/visibility" method="post" class="inline-form">
    <input type="hidden" name="show" value="<%= hidden ? '1' : '0' %>" />
    <button type="submit" class="btn btn--sm <%= hidden ? 'btn--primary' : 'btn--ghost' %>"><%= hidden ? 'Show on website' : 'Hide from website' %></button>
  </form>
</div>

<div class="hub-card">
  <% if (team.length) { %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Order</th><th>Photo</th><th>Name</th><th>Role</th><th></th></tr></thead>
      <tbody>
        <% team.forEach(function (m, i) { var src = m.photo && m.photo.indexOf('/team-photo/') === 0 ? '/admin/staff-photo/' + m.userId : photoSrc(m.photo); %>
        <tr>
          <td style="white-space:nowrap;">
            <span class="muted tabnum"><%= i + 1 %></span>
            <% if (canEdit) { %>
            <form action="/admin/team/<%= m.id %>/move" method="post" class="inline-form"><input type="hidden" name="dir" value="up" /><button type="submit" class="btn btn--muted btn--sm" aria-label="Move <%= m.name %> up" <%= i === 0 ? 'disabled' : '' %>>↑</button></form>
            <form action="/admin/team/<%= m.id %>/move" method="post" class="inline-form"><input type="hidden" name="dir" value="down" /><button type="submit" class="btn btn--muted btn--sm" aria-label="Move <%= m.name %> down" <%= i === team.length - 1 ? 'disabled' : '' %>>↓</button></form>
            <% } %>
          </td>
          <td><% if (src) { %><img class="team-thumb" src="<%= src %>" alt="" width="44" height="44" /><% } else { %><span class="muted">None</span><% } %></td>
          <td><strong><%= m.name %></strong><% if (m.userId) { %> <span class="hub-pill hub-pill--plain">Directory</span><% } %></td>
          <td><%= m.role || '' %></td>
          <td style="white-space:nowrap;">
            <% if (canEdit) { %>
            <a href="/admin/team/<%= m.id %>/edit" class="btn btn--muted btn--sm">Edit</a>
            <form action="/admin/team/<%= m.id %>/delete" method="post" class="inline-form" data-confirm="Remove <%= m.name.replace(/"/g, '') %> from the Our team page?">
              <button type="submit" class="btn btn--muted btn--sm">Remove</button>
            </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <p class="muted">No one on the Our team page yet.</p>
  <% } %>
</div>

<% if (canEdit) { %>
<form action="/admin/team/home-staff" method="post" class="hub-card" id="home-teams">
  <div class="hub-card__head"><h2>Home teams</h2></div>
  <% if (!homeStaff.length) { %><div class="hub-card__body"><p class="muted" style="margin:0;">No home staff in the directory yet.</p></div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Name</th><th>Home</th><th>Photo</th><th>Show on website</th></tr></thead>
    <tbody>
      <% homeStaff.forEach(function (u) { %>
      <tr>
        <td><strong><%= u.name %></strong><% if (u.title) { %><div class="hint"><%= u.title %></div><% } %></td>
        <td><%= homesLabel(u) %></td>
        <td><%= u.photoKey && u.photoConsent ? 'Yes' : u.photoKey ? 'No consent' : '—' %></td>
        <td><label class="switch-check"><input type="checkbox" name="show" value="<%= u.id %>" <%= u.showOnWebsite ? 'checked' : '' %> /><span class="switch__track" aria-hidden="true"></span><span class="sr-only">Show <%= u.name %> on the website</span></label></td>
      </tr>
      <% }) %>
    </tbody>
  </table></div>
  <div class="hub-card__body"><button type="submit" class="btn btn--primary">Save</button></div>
  <% } %>
</form>
<% } %>

<%- include('../partials/admin-footer') %>
