<%- include('../partials/admin-header') %>

<div class="crumbs" style="color:var(--muted);margin-bottom:.5rem;"><a href="/admin">Dashboard</a> › Care homes</div>
<div class="panel__head" style="border:0;padding:0;align-items:flex-start;">
  <div>
    <h1 class="admin-h1">Care homes</h1>
    <p class="muted">These are the homes shown on <a href="/care-homes" target="_blank" rel="noopener">Find a home</a>. Changes appear on the site straight away.</p>
  </div>
  <a href="/admin/homes/new" class="btn btn--primary">+ Add a home</a>
</div>

<% if (typeof error !== 'undefined' && error) { %>
<div class="alert alert--error" style="margin-top:1.25rem;"><%= error %></div>
<% } %>

<div class="panel" style="margin-top:1.5rem;">
  <div class="panel__head">
    <h2>All homes <span class="panel__count"><%= homes.length %></span></h2>
  </div>

  <% if (homes.length) { %>
  <div class="table-wrap">
    <table class="admin-table homes-table">
      <thead>
        <tr>
          <th>Home</th>
          <th>Where</th>
          <th>Care provided</th>
          <th class="num">Beds</th>
          <th>CQC</th>
          <th class="num">Jobs</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% homes.forEach(function(h){ %>
        <tr>
          <td>
            <div class="home-row">
              <span class="home-row__thumb"<% if (h.photo) { %> style="background-image:url('<%= photoUrl(h.photo) %>');"<% } %>></span>
              <span>
                <strong><%= h.name %></strong><br />
                <a href="/care-homes/<%= h.id %>" target="_blank" rel="noopener" class="muted" style="font-size:.82rem;">View page ↗</a>
              </span>
            </div>
          </td>
          <td><%= h.town %><br /><span class="muted" style="font-size:.82rem;"><%= h.postcode %> · <%= h.region %></span></td>
          <td>
            <% if (h.careTypes && h.careTypes.length) { %>
            <span class="mini-chips">
              <% h.careTypes.forEach(function(c){ %><span class="mini-chip"><%= c.replace(/ Care$/, '') %></span><% }) %>
            </span>
            <% } else { %>
              <span class="muted" style="font-size:.84rem;">—</span>
            <% } %>
          </td>
          <td class="num"><%= h.beds || '—' %></td>
          <td><%= h.cqc || '—' %></td>
          <td class="num"><%= jobCounts[h.id] || 0 %></td>
          <td>
            <div class="row-actions">
              <a href="/admin/homes/<%= h.id %>/edit" class="btn btn--sm btn--ghost">Edit</a>
              <form action="/admin/homes/<%= h.id %>/delete" method="post" class="inline-form"
                    onsubmit="return confirm('Delete <%= h.name.replace(/'/g, "\\'") %>? This cannot be undone.');">
                <button type="submit" class="btn btn--sm btn--danger">Delete</button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <div class="panel__body">
    <div class="empty-state">
      <h3>No homes yet</h3>
      <p>Add your first care home and it'll appear on the public site immediately.</p>
      <a href="/admin/homes/new" class="btn btn--primary" style="margin-top:.5rem;">+ Add a home</a>
    </div>
  </div>
  <% } %>
</div>

<%- include('../partials/admin-footer') %>
