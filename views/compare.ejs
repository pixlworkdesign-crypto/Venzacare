<%- include('partials/header') %>

<section class="page-hero">
  <div class="container">
    <div class="crumbs"><a href="/">Home</a> › <a href="/care-homes">Find a home</a> › Compare</div>
    <span class="eyebrow hero__eyebrow">Our homes</span>
    <h1>Compare our homes</h1>
  </div>
</section>

<% var tick = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-label="Yes"><path d="M20 6 9 17l-5-5"/></svg>';
   var dash = '<span class="cmp-no" aria-label="No">—</span>';
   var availWords = { available: 'Rooms free now', limited: 'One or two rooms free', waitlist: 'Waiting list' };
   var ids = picked.map(function (h) { return h.id; });
   function urlWith(n, id) { var x = ids.slice(); if (id) x[n] = id; else x.splice(n, 1); return '/compare?h=' + x.join(','); }
   var specAll = [], facAll = {};
   picked.forEach(function (h) { (h.specialisms || []).forEach(function (s) { if (specAll.indexOf(s) < 0) specAll.push(s); }); });
   picked.forEach(function (h) { homeFacilities(SITE, h).forEach(function (g) { facAll[g.group] = facAll[g.group] || []; g.items.forEach(function (x) { if (facAll[g.group].indexOf(x) < 0) facAll[g.group].push(x); }); }); });
   function hasFac(h, x) { return homeFacilityNames(h).indexOf(x) > -1; } %>

<section class="section">
  <div class="container">
    <form class="cmp-pick" action="/compare" method="get" id="cmpForm">
      <% [0, 1, 2].forEach(function (n) { if (n > picked.length) return; %>
      <div class="field">
        <label for="pick<%= n %>"><%= n < picked.length ? 'Home ' + (n + 1) : 'Add a home' %></label>
        <select id="pick<%= n %>" data-slot="<%= n %>">
          <% if (n === picked.length) { %><option value="">Choose…</option><% } %>
          <% all.forEach(function (h) { var taken = ids.indexOf(h.id) > -1 && ids[n] !== h.id; if (taken) return; %><option value="<%= h.id %>" <%= ids[n] === h.id ? 'selected' : '' %>><%= h.name %>, <%= h.town %></option><% }) %>
        </select>
        <% if (n < picked.length && picked.length > 1) { %><a class="cmp-remove" href="<%= urlWith(n) %>">Remove</a><% } %>
      </div>
      <% }) %>
      <noscript><button class="btn btn--primary btn--sm">Compare</button></noscript>
    </form>

    <div class="table-wrap cmp-wrap">
      <table class="cmp">
        <thead>
          <tr><th scope="col"><span class="sr-only">Detail</span></th>
            <% picked.forEach(function (h) { %>
            <th scope="col">
              <% if (h.photo) { %><img src="<%= photoSrc(h.photo) %>" alt="" loading="lazy" /><% } %>
              <a href="/care-homes/<%= h.id %>"><%= h.name %></a>
              <span class="cmp-town"><%= h.town %></span>
            </th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <tr><th scope="row">CQC rating</th><% picked.forEach(function (h) { %><td><span class="cqc-pill <%= cqcClass(h) %>"><%= cqcLabel(h) %></span></td><% }) %></tr>
          <tr><th scope="row">Beds</th><% picked.forEach(function (h) { %><td><%= h.beds || '—' %></td><% }) %></tr>
          <tr><th scope="row">Room availability</th><% picked.forEach(function (h) { %><td><%= availWords[h.details.availability] || '—' %></td><% }) %></tr>
          <% FEE_ROWS.forEach(function (r) { %>
          <tr><th scope="row"><%= r.label %> <span class="cmp-sub">per week</span></th><% picked.forEach(function (h) { var v = h.details.fees && h.details.fees[r.key]; %><td><%= v ? 'from ' + gbp(v) : '—' %></td><% }) %></tr>
          <% }) %>

          <tr class="cmp-group"><th scope="rowgroup" colspan="<%= picked.length + 1 %>">Types of care</th></tr>
          <% careTypeNames(SITE).forEach(function (c) { %>
          <tr><th scope="row"><%= c %></th><% picked.forEach(function (h) { %><td><%- h.careTypes.indexOf(c) > -1 ? tick : dash %></td><% }) %></tr>
          <% }) %>

          <% if (specAll.length) { %>
          <tr class="cmp-group"><th scope="rowgroup" colspan="<%= picked.length + 1 %>">Specialist care</th></tr>
          <% specAll.forEach(function (s) { %>
          <tr><th scope="row"><%= s %></th><% picked.forEach(function (h) { %><td><%- (h.specialisms || []).indexOf(s) > -1 ? tick : dash %></td><% }) %></tr>
          <% }) %>
          <% } %>

          <% Object.keys(facAll).forEach(function (g) { %>
          <tr class="cmp-group"><th scope="rowgroup" colspan="<%= picked.length + 1 %>"><%= g %></th></tr>
          <% facAll[g].forEach(function (x) { %>
          <tr><th scope="row"><%= x %></th><% picked.forEach(function (h) { %><td><%- hasFac(h, x) ? tick : dash %></td><% }) %></tr>
          <% }) %>
          <% }) %>

          <tr class="cmp-group"><th scope="rowgroup" colspan="<%= picked.length + 1 %>">Your visit</th></tr>
          <tr><th scope="row">Visiting hours</th><% picked.forEach(function (h) { %><td><%= h.details.visitingHours || '—' %></td><% }) %></tr>
          <tr><th scope="row">Home manager</th><% picked.forEach(function (h) { %><td><%= h.details.managerName || '—' %></td><% }) %></tr>
          <tr><th scope="row"><span class="sr-only">Book</span></th><% picked.forEach(function (h) { %><td><a class="btn btn--primary btn--sm" href="/care-homes/<%= h.id %>#visit">Book a visit</a></td><% }) %></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('#cmpForm select').forEach(function (sel) {
    sel.addEventListener('change', function () {
      var ids = <%- JSON.stringify(ids) %>;
      var n = +sel.getAttribute('data-slot');
      if (sel.value) ids[n] = sel.value; else ids.splice(n, 1);
      location.href = '/compare?h=' + ids.filter(Boolean).join(',');
    });
  });
</script>

<%- include('partials/footer') %>
