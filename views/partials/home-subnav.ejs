<% /* Section tabs for a home's page and its Meet the team page. */
   var base = '/care-homes/' + home.id, onTeam = current === 'team', booking = team && team.booking;
   var hasReviews = ((home.details || {}).testimonials || []).length > 0; %>
<nav class="tm-subnav" aria-label="<%= home.name %> sections">
  <div class="container tm-subnav__in">
    <a href="<%= onTeam ? base : '#overview' %>" class="<%= !onTeam ? 'is-on' : '' %>">Overview</a>
    <a href="<%= onTeam ? base + '#care' : '#care' %>">Care</a>
    <a href="<%= onTeam ? base + '#fees' : '#fees' %>">Fees</a>
    <a href="<%= base %>/team" class="<%= onTeam ? 'is-on' : '' %>"<%- onTeam ? ' aria-current="page"' : '' %>>Meet the team</a>
    <a href="<%= onTeam && !hasReviews ? base + '#reviews' : '#reviews' %>">Reviews</a>
    <% if (booking) { %><a href="<%= onTeam ? base + '#visit' : '#visit' %>">Visit</a><% } %>
  </div>
</nav>
