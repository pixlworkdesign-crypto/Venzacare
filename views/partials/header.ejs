<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <% var pageTitle = (title ? title + ' · ' : '') + SITE.name;
     var pageDesc = description || 'Venza Care UK runs CQC-regulated care homes' + (areaText ? ' in ' + areaText : '') + ' — residential, nursing, dementia, respite and end-of-life care.'; %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>" />
  <link rel="canonical" href="<%= canonical %>" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="<%= SITE.name %>" />
  <meta property="og:title" content="<%= pageTitle %>" />
  <meta property="og:description" content="<%= pageDesc %>" />
  <meta property="og:url" content="<%= canonical %>" />
  <meta property="og:image" content="<%= (typeof home !== 'undefined' && home && home.photo) ? photoAbs(home.photo, baseUrl) : photoAbs(siteImage(SITE, 'hero'), baseUrl) %>" />
  <meta property="og:locale" content="en_GB" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0d4f5c" />
  <% if (jsonLd) { %><script type="application/ld+json"><%- ldScript(jsonLd) %></script><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="icon" type="image/png" href="/images/logo.png" />
</head>
<body class="page">
  <a class="skip-link" href="#main">Skip to main content</a>
  <header class="nav">
    <div class="nav__inner">
      <a href="/" class="brand" aria-label="Venza Care UK home">
        <img src="/images/logo.png" alt="Venza Care" class="brand__logo" />
      </a>
      <nav class="nav__links" id="navlinks">
        <a href="/about-us" class="<%= ['/about-us', '/our-team'].includes(currentPath) ? 'is-active' : '' %>">About Us</a>
        <a href="/our-care" class="<%= currentPath === '/our-care' ? 'is-active' : '' %>">Our Care</a>
        <a href="/care-homes" class="<%= (currentPath.startsWith('/care-homes') && !/\/team$/.test(currentPath)) || currentPath === '/compare' ? 'is-active' : '' %>">Find a Home</a>
        <a href="/help-and-advice" class="<%= ['/help-and-advice', '/fees-and-funding', '/cqc-ratings', '/faqs'].includes(currentPath) ? 'is-active' : '' %>">Help &amp; Advice</a>
        <a href="/careers">Careers</a>
        <a href="/contact" class="<%= currentPath === '/contact' ? 'is-active' : '' %>">Contact Us</a>
      </nav>
      <button class="nav-toggle" aria-label="Menu" aria-controls="navlinks" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>
  <main id="main">
