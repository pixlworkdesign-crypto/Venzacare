<%- include('partials/header') %>

<section class="page-hero">
  <div class="container">
    <div class="crumbs"><a href="/">Home</a> › Our care</div>
    <span class="eyebrow hero__eyebrow">Our care</span>
    <h1>Care that grows as needs change</h1>
    <p>From a little help each day or a short respite stay to round-the-clock nursing and specialist dementia care, our homes support people as their needs change. Here's what each kind of care actually means.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% function homesWith(type) {
         return homes.filter(function(h){ return h.careTypes.indexOf(type) > -1; }).map(function(h){ return h.name + ' (' + h.town + ')'; });
       }
       function listNames(a) { return a.length > 1 ? a.slice(0, -1).join(', ') + ' and ' + a[a.length - 1] : a.join(''); }
       var care = careTypesOf(SITE);
    care.forEach(function(c, idx){ %>
    <% var where = homesWith(c.name); var anchor = c.name.toLowerCase().replace(/[^a-z]+/g, '-'); var img = careImage(SITE, c); %>
    <div class="split <%= idx % 2 ? 'split--reverse' : '' %>" id="<%= anchor %>" style="margin-bottom: 3.5rem;scroll-margin-top:96px;">
      <% if (img) { %><div class="split__media split__media--bordered has-photo" style="background-image:url('<%= img %>'); background-position: <%= c.position || 'center 22%' %>;"></div><% } else { %><div class="split__media split__media--bordered"></div><% } %>
      <div>
        <h2 class="h2" style="font-size:1.9rem;"><%= c.name %></h2>
        <% if (c.description) { %><p class="lead" style="font-size:1.05rem;"><%= c.description %></p><% } %>
        <% if (where.length) { %><p class="muted" style="margin-top:-.4rem;"><strong style="color:var(--green-800)">Available at:</strong> <%= where.length === homes.length ? 'all our homes — ' + listNames(where) : listNames(where) %>.</p><% } %>
        <a href="/care-homes?careType=<%= encodeURIComponent(c.name) %>" class="btn btn--ghost mt-1">Find <%= c.name.toLowerCase() %> homes</a>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="cta-band" style="background:linear-gradient(120deg,var(--green-800),var(--green-600));">
      <h2>Not sure which kind of care fits?</h2>
      <p>Tell us about your situation and we'll talk it through — and point you to the right home, or be honest if we're not the best fit. We reply to every enquiry within one working day.</p>
      <a href="/care-homes" class="btn btn--gold">Book a visit</a>
      <a href="/care-homes" class="btn btn--outline-light">Find a home</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
