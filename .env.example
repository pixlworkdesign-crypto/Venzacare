# =============================================================
# Venza Care UK — environment variables
# Copy to .env for local development, and set the same keys in
# Vercel (Settings → Environment Variables) for production.
# =============================================================

# --- Admin sign-in (REQUIRED in production; the app refuses to start without) ---
ADMIN_USER=admin
ADMIN_PASS=                 # long and random — this repo is public
SESSION_SECRET=             # long and random; signs the admin session cookie

# --- Database (Supabase) ---
# Supabase → Project Settings → Database → Connection string → "Transaction pooler"
# Without this the app falls back to a JSON file, which does NOT persist on Vercel.
DATABASE_URL=

# --- File storage for CVs (Supabase Storage) ---
# Supabase → Project Settings → API.  Create a PRIVATE bucket named "cvs".
# The service role key is a server-side secret — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CV_BUCKET=cvs

# --- Email alerts for new enquiries and applications (Resend) ---
# Sign up at resend.com and verify venzacare.co.uk as a sending domain,
# otherwise messages are rejected or land in spam.
# With no key set, forms still work — nothing is emailed.
RESEND_API_KEY=
MAIL_FROM=Venza Care website <site@venzacare.co.uk>
MAIL_TO=                    # defaults to the site's own enquiries address
SITE_URL=https://venzacare.co.uk   # so links in those emails are absolute

# --- Optional: the on-site AI assistant ---
ANTHROPIC_API_KEY=
