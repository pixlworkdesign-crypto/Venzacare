# =============================================================
# Venza Care UK — environment variables
# Copy to .env for local development, and set the same keys in
# Vercel (Settings → Environment Variables) for production.
# =============================================================

# --- Staff hub sign-in ---
# SESSION_SECRET is REQUIRED in production (signs sign-in cookies).
SESSION_SECRET=             # long and random
# The emergency owner login — how you get in on day one, and the only way to
# change an owner's account. It is NOT your Supabase password.
ADMIN_USER=admin
ADMIN_PASS=                 # long and random — this repo is public

# --- Optional: email (invites, password resets, noticeboard, reminders) ---
# Free account at resend.com; EMAIL_FROM must be on a domain you've verified there.
RESEND_API_KEY=
EMAIL_FROM=Venza Care <noreply@venzacare.co.uk>
# Protects /api/cron/certificates (daily certificate reminder emails)
CRON_SECRET=

# --- Database (Supabase) ---
# Supabase → Project Settings → Database → Connection string → "Transaction pooler"
# Without this the app falls back to a JSON file, which does NOT persist on Vercel.
DATABASE_URL=

# --- File storage for CVs (Supabase Storage) ---
# Supabase → Project Settings → API.  Create a PRIVATE bucket named "cvs".
# The service role key is a server-side secret — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CV_BUCKET=cvs

# --- The live address (canonical links, sitemap, social previews) ---
SITE_URL=https://www.venzacare.co.uk

# --- Optional: the on-site AI assistant ---
ANTHROPIC_API_KEY=
